{
  "name": "tinycode-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Conversor local de código a HTML compatible con Moodle.",
  "scripts": {
    "build": "node tools/build-bundle.mjs",
    "pretest": "node tools/build-bundle.mjs",
